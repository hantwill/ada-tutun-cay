# Ada Çay Evi — Environment Variables
# Bu dosyayı kopyala: cp .env.example .env
# Sonra değerleri değiştir!

# Database
DB_USER=postgres
DB_PASS=change_me_to_strong_password

# JWT Secret (en az 32 karakter, rastgele)
# Üretmek için: openssl rand -base64 48
JWT_SECRET=change_me_in_production

# CORS Origin (production'da frontend URL'i)
CORS_ORIGIN=*